<Dictionary Key="72151be6-4b5b-4a91-a9bb-af8d861f170d" Alias="Settings Google Tag Manager activate description" Level="4">
  <Info>
    <Parent>Settings Google Tag Manager tab</Parent>
  </Info>
  <Translations>
    <Translation Language="en-US">Turns Google Tag Manager on or off. A valid container id also needs to be supplied for this to work.</Translation>
    <Translation Language="nl-NL">Zet de Google Tag Manager aan en uit. Een geldig container-id is vereist.</Translation>
  </Translations>
</Dictionary>