  <Translations>
    <Translation Language="en-US">Is used as the title by social media when this page is shared. If not set, the meta description will be used.</Translation>
    <Translation Language="nl-NL">Wordt gebruikt als titel op social media als deze pagina gedeeld wordt. Indien niet ingevuld zal de meta description gebruikt worden.</Translation>
  </Translations>
