  <Translations>
    <Translation Language="en-US">We want to notify you because you filled a form using our website. In this mail you can find your submitted data</Translation>
    <Translation Language="nl-NL">Via onze website heeft u een van onze formulieren ingevuld, deze is in goede orde ontvangen. Zie onderstaande opsomming van de ingevulde gegevens</Translation>
  </Translations>
