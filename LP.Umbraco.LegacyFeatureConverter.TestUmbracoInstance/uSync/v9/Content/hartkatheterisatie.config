      "contentTypeKey": "2fb273bd-b969-4ce8-8f41-7fa91a9ec3a8",
      "editorialContent": "umb://document/4bfdf105635c420c81b1903e04714ae2",
      "udi": "umb://element/407d747ab8fc4fd1bdc3c5e840ba7328"
    },
    {
      "contentTypeKey": "d9e78940-efcf-406f-9dfd-85b46f62ed51",
      "editorialContent": "umb://document/feb48aea42034bf7925747421cadf0c4",
      "udi": "umb://element/dc3bff6706dd4b01a302d77c53bb8a88"
    },
    {
      "contentTypeKey": "b82f5cb4-6576-4045-8b07-87cb704ecc95",
      "text": {
        "markup": "<div class=\"default-introduction text-basics\">Met een hartkatheterisatie is het mogelijk om de kransslagaderen, de aorta (grote lichaamsslagader) en de verschillende hartholten te onderzoeken. Wat wordt onderzocht is afhankelijk van de vraag van de cardioloog. Onderzoek naar de kransslagaderen heet een Coronair Angiogram (CAG).</div>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/3f91f2d96fa4471983c1e720afb5f11d"
    }
  ],
  "settingsData": []
}]]></Value>
    </redactioneleBlokken>
