    <activationBlockText>
      <Value Culture="en-us"><![CDATA[]]></Value>
      <Value Culture="nl-nl"><![CDATA[{
  "markup": "<p>Werken in hét stadsziekenhuis van Amsterdam? Ga naar&nbsp;<umb-rte-block-inline data-content-udi=\"umb://element/acf71f12c0bd48aead07240755cad3c4\"><!--Umbraco-Block--></umb-rte-block-inline> Bekijk de actuele vacatures op werkenbijolvg.nl</p>\n<umb-rte-block data-content-udi=\"umb://element/191d2cf44bad4cdc80a52d130e3161cb\"><!--Umbraco-Block--></umb-rte-block>\n<p>Would you like to work in the city's leading hospital in Amsterdam? View the current vacancies at werkbijolvg.nl</p>\n<p>Tabel:</p>\n<table border=\"1\" style=\"border-collapse: collapse; width: 100%; height: 36px;\">\n<tbody>\n<tr>\n<td style=\"width: 50%;\">Rij</td>\n<td style=\"width: 50%;\">Kolom</td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 50%; height: 18px;\">Test 1</td>\n<td style=\"width: 50%; height: 18px;\">Test 2</td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 50%; height: 18px;\">Test 3</td>\n<td style=\"width: 50%; height: 18px;\">Test 4</td>\n</tr>\n</tbody>\n</table>\n<div class=\"component-files-download-editor\">Test</div>\n<h2>Kop 2</h2>\n<h3>Kop 3</h3>\n<h4>Kop 4</h4>\n<div class=\"mceNonEditable embeditem\" data-embed-url=\"\nhttps://www.youtube.com/watch?v=HBL7Qw5fwPg\" data-embed-height=\"240\" data-embed-width=\"360\" data-embed-constrain=\"true\"><iframe width=\"360\" height=\"203\" src=\"https://www.youtube.com/embed/HBL7Qw5fwPg?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen=\"allowfullscreen\" title=\"Werken bij OLVG - verpleegkundige\"></iframe></div>\n<div class=\"component-files-download-editor\"><a href=\"/{localLink:umb://media/34238c85fb494bdf8c996679b8846f96}\" title=\"Skatebowl voorbeeld\">Document downloaden</a></div>\n<p><img style=\"float: left;\" src=\"?width=400&amp;height=400\" alt=\"\" width=\"400\" height=\"400\" data-udi=\"umb://media/9d671e4abc474234a6bc2125b3a4b055\">Hier moet tekst komen en de afbeelding moet links uitgelijnd worden.</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p>",
  "blocks": {
    "layout": {
      "Umbraco.TinyMCE": [
        {
          "contentUdi": "umb://element/191d2cf44bad4cdc80a52d130e3161cb"
