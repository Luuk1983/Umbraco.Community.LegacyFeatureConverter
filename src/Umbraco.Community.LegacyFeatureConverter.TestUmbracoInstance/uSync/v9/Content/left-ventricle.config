    <pageElements>
      <Value Culture="nl-nl"><![CDATA[{
  "layout": {
    "Umbraco.BlockList": [
      {
        "contentUdi": "umb://element/bd23cd6ec11e464d9622b6c6cc6c914b"
      },
      {
        "contentUdi": "umb://element/53829e347f694941b9895665969714a9"
      }
    ]
  },
  "contentData": [
    {
      "backgroundImage": [],
      "backgroundImageOverlap": "0",
      "contentItemContentText": {
        "markup": "<p>Each echocardiogram include an assessment of LV dimensions, describing wall thickness and function. Good measurements are essential and may have implications for therapy. LV dimensions must be measured in PLAX, end-diastolic and end-systolic and valves (MV and AOV) are closed. The measurement is situated in the basal part of the LV by the chordae.</p>\n<p><img src=\"?width=200&amp;height=134\" alt=\"\" width=\"200\" height=\"134\" data-udi=\"umb://media/91da3e23468d4decbd7c4e6ad8c28ff5\"></p>\n<p> </p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "contentItemTitle": "LV dimensions",
      "contentTypeKey": "73fd841a-758a-4e00-8f71-eeeab3cb9cfd",
      "udi": "umb://element/bd23cd6ec11e464d9622b6c6cc6c914b"
    },
    {
      "backgroundImage": [],
      "backgroundImageOverlap": "0",
      "contentItemContentText": {
        "markup": "<h3>Reference limits and partition values of left ventricular size</h3>\n<table border=\"1\" style=\"border-collapse: collapse; width: 1102px;\">\n<tbody>\n<tr style=\"height: 18px;\">\n<td style=\"width: 594px; height: 18px;\"> </td>\n<td style=\"width: 185px; height: 18px;\">MEN</td>\n<td style=\"width: 132px; height: 18px;\"> </td>\n<td style=\"width: 153px; height: 18px;\"> </td>\n<td style=\"width: 179px; height: 18px;\"> </td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 594px; height: 18px;\"> </td>\n<td style=\"width: 185px; height: 18px;\">Reference</td>\n<td style=\"width: 132px; height: 18px;\">Mildly</td>\n<td style=\"width: 153px; height: 18px;\">Moderately</td>\n<td style=\"width: 179px; height: 18px;\">Severely</td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 594px; height: 18px;\"> </td>\n<td style=\"width: 185px; height: 18px;\">Range</td>\n<td style=\"width: 132px; height: 18px;\">Abnormal</td>\n<td style=\"width: 153px; height: 18px;\">Abnormal</td>\n<td style=\"width: 179px; height: 18px;\">Abnormal</td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 594px; height: 18px;\">LV dimension</td>\n<td style=\"width: 185px; height: 18px;\"> </td>\n<td style=\"width: 132px; height: 18px;\"> </td>\n<td style=\"width: 153px; height: 18px;\"> </td>\n<td style=\"width: 179px; height: 18px;\"> </td>\n</tr>\n<tr style=\"height: 36px;\">\n<td style=\"width: 594px; height: 36px;\">LV diastolic diameter, cm</td>\n<td style=\"width: 185px; height: 36px;\">4.2–5.8</td>\n<td style=\"width: 132px; height: 36px;\">5.9–6.3</td>\n<td style=\"width: 153px; height: 36px;\">6.4–6.8</td>\n<td style=\"width: 179px; height: 36px;\">≥6.9</td>\n</tr>\n<tr style=\"height: 54px;\">\n<td style=\"width: 594px; height: 54px;\">LV diastolic diameter/BSA, cm/m2</td>\n<td style=\"width: 185px; height: 54px;\">2.2–3.0</td>\n<td style=\"width: 132px; height: 54px;\">3.1–3.3</td>\n<td style=\"width: 153px; height: 54px;\">3.4–3.6</td>\n<td style=\"width: 179px; height: 54px;\">≥3.7</td>\n</tr>\n<tr style=\"height: 36px;\">\n<td style=\"width: 594px; height: 36px;\">LV systolic diameter</td>\n<td style=\"width: 185px; height: 36px;\">2.5–4.0</td>\n<td style=\"width: 132px; height: 36px;\">4.1–4.3</td>\n<td style=\"width: 153px; height: 36px;\">4.4–4.5</td>\n<td style=\"width: 179px; height: 36px;\">≥4.6</td>\n</tr>\n<tr style=\"height: 54px;\">\n<td style=\"width: 594px; height: 54px;\">LV systolic diameter/BSA, cm/m2</td>\n<td style=\"width: 185px; height: 54px;\">1.3–2.1</td>\n<td style=\"width: 132px; height: 54px;\">2.2–2.3</td>\n<td style=\"width: 153px; height: 54px;\">2.4–2.5</td>\n<td style=\"width: 179px; height: 54px;\">≥2.6</td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 594px; height: 18px;\">LV volume</td>\n<td style=\"width: 185px; height: 18px;\"> </td>\n<td style=\"width: 132px; height: 18px;\"> </td>\n<td style=\"width: 153px; height: 18px;\"> </td>\n<td style=\"width: 179px; height: 18px;\"> </td>\n</tr>\n<tr style=\"height: 36px;\">\n<td style=\"width: 594px; height: 36px;\">LV diastolic volume, mL</td>\n<td style=\"width: 185px; height: 36px;\">62–150</td>\n<td style=\"width: 132px; height: 36px;\">151–174</td>\n<td style=\"width: 153px; height: 36px;\">175–200</td>\n<td style=\"width: 179px; height: 36px;\">≥201</td>\n</tr>\n<tr style=\"height: 54px;\">\n<td style=\"width: 594px; height: 54px;\">LV diastolic volume/BSA, mL/m2</td>\n<td style=\"width: 185px; height: 54px;\">34–74</td>\n<td style=\"width: 132px; height: 54px;\">75–89</td>\n<td style=\"width: 153px; height: 54px;\">90–100</td>\n<td style=\"width: 179px; height: 54px;\">≥101</td>\n</tr>\n<tr style=\"height: 36px;\">\n<td style=\"width: 594px; height: 36px;\">LV systolic volume, mL</td>\n<td style=\"width: 185px; height: 36px;\">21–61</td>\n<td style=\"width: 132px; height: 36px;\">62–73</td>\n<td style=\"width: 153px; height: 36px;\">74–85</td>\n<td style=\"width: 179px; height: 36px;\">≥86</td>\n</tr>\n<tr style=\"height: 54px;\">\n<td style=\"width: 594px; height: 54px;\">LV systolic volume/BSA, mL/m2</td>\n<td style=\"width: 185px; height: 54px;\">11–31</td>\n<td style=\"width: 132px; height: 54px;\">32–38</td>\n<td style=\"width: 153px; height: 54px;\">39–45</td>\n<td style=\"width: 179px; height: 54px;\">≥46</td>\n</tr>\n</tbody>\n</table>\n<p> </p>\n<table border=\"1\" style=\"border-collapse: collapse; width: 77.6685%; height: 450px;\">\n<tbody>\n<tr style=\"height: 18px;\">\n<td style=\"width: 30.0991%; height: 18px;\"> </td>\n<td style=\"width: 9.90052%; height: 18px;\">WOMEN</td>\n<td style=\"width: 7.2066%; height: 18px;\"> </td>\n<td style=\"width: 9.38445%; height: 18px;\"> </td>\n<td style=\"width: 9.57649%; height: 18px;\"> </td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 30.0991%; height: 18px;\"> </td>\n<td style=\"width: 9.90052%; height: 18px;\">Reference</td>\n<td style=\"width: 7.2066%; height: 18px;\">Mildly</td>\n<td style=\"width: 9.38445%; height: 18px;\">Moderately</td>\n<td style=\"width: 9.57649%; height: 18px;\">Severely</td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 30.0991%; height: 18px;\"> </td>\n<td style=\"width: 9.90052%; height: 18px;\">Range</td>\n<td style=\"width: 7.2066%; height: 18px;\">Abnormal</td>\n<td style=\"width: 9.38445%; height: 18px;\">Abnormal</td>\n<td style=\"width: 9.57649%; height: 18px;\">Abnormal</td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 30.0991%; height: 18px;\">LV dimension</td>\n<td style=\"width: 9.90052%; height: 18px;\"> </td>\n<td style=\"width: 7.2066%; height: 18px;\"> </td>\n<td style=\"width: 9.38445%; height: 18px;\"> </td>\n<td style=\"width: 9.57649%; height: 18px;\"> </td>\n</tr>\n<tr style=\"height: 36px;\">\n<td style=\"width: 30.0991%; height: 36px;\">LV diastolic diameter, cm</td>\n<td style=\"width: 9.90052%; height: 36px;\">3.8–5.2</td>\n<td style=\"width: 7.2066%; height: 36px;\">5.3–5.6</td>\n<td style=\"width: 9.38445%; height: 36px;\">5.7–6.1</td>\n<td style=\"width: 9.57649%; height: 36px;\"><span> ≥6.2</span></td>\n</tr>\n<tr style=\"height: 54px;\">\n<td style=\"width: 30.0991%; height: 54px;\">LV diastolic diameter/BSA, cm/m2</td>\n<td style=\"width: 9.90052%; height: 54px;\">2.3–3.1</td>\n<td style=\"width: 7.2066%; height: 54px;\">3.2–3.4</td>\n<td style=\"width: 9.38445%; height: 54px;\">3.5–3.7</td>\n<td style=\"width: 9.57649%; height: 54px;\"><span> ≥3.8</span></td>\n</tr>\n<tr style=\"height: 36px;\">\n<td style=\"width: 30.0991%; height: 36px;\">LV systolic diameter</td>\n<td style=\"width: 9.90052%; height: 36px;\"><span> 2.2–3.5</span></td>\n<td style=\"width: 7.2066%; height: 36px;\"><span> 3.6–3.8</span></td>\n<td style=\"width: 9.38445%; height: 36px;\">3.9–4.1</td>\n<td style=\"width: 9.57649%; height: 36px;\"><span> ≥4.2</span></td>\n</tr>\n<tr style=\"height: 54px;\">\n<td style=\"width: 30.0991%; height: 54px;\">LV systolic diameter/BSA, cm/m2</td>\n<td style=\"width: 9.90052%; height: 54px;\"><span> 1.3–2.1</span></td>\n<td style=\"width: 7.2066%; height: 54px;\"><span> 2.2–2.3</span></td>\n<td style=\"width: 9.38445%; height: 54px;\"><span> 2.4–2.6</span></td>\n<td style=\"width: 9.57649%; height: 54px;\"><span> ≥2.7</span></td>\n</tr>\n<tr style=\"height: 18px;\">\n<td style=\"width: 30.0991%; height: 18px;\">LV volume</td>\n<td style=\"width: 9.90052%; height: 18px;\"> </td>\n<td style=\"width: 7.2066%; height: 18px;\"> </td>\n<td style=\"width: 9.38445%; height: 18px;\"> </td>\n<td style=\"width: 9.57649%; height: 18px;\"> </td>\n</tr>\n<tr style=\"height: 36px;\">\n<td style=\"width: 30.0991%; height: 36px;\">LV diastolic volume, mL</td>\n<td style=\"width: 9.90052%; height: 36px;\">46–106</td>\n<td style=\"width: 7.2066%; height: 36px;\">107–120</td>\n<td style=\"width: 9.38445%; height: 36px;\">121–130</td>\n<td style=\"width: 9.57649%; height: 36px;\"><span> ≥131</span></td>\n</tr>\n<tr style=\"height: 54px;\">\n<td style=\"width: 30.0991%; height: 54px;\">LV diastolic volume/BSA, mL/m2</td>\n<td style=\"width: 9.90052%; height: 54px;\"><span> 29–61</span></td>\n<td style=\"width: 7.2066%; height: 54px;\"><span> 62–70</span></td>\n<td style=\"width: 9.38445%; height: 54px;\"><span> 71–80</span></td>\n<td style=\"width: 9.57649%; height: 54px;\">≥81</td>\n</tr>\n<tr style=\"height: 36px;\">\n<td style=\"width: 30.0991%; height: 36px;\">LV systolic volume, mL</td>\n<td style=\"width: 9.90052%; height: 36px;\">14–42</td>\n<td style=\"width: 7.2066%; height: 36px;\"><span> 43–55</span></td>\n<td style=\"width: 9.38445%; height: 36px;\"><span> 56–67</span></td>\n<td style=\"width: 9.57649%; height: 36px;\"><span> ≥68</span></td>\n</tr>\n<tr style=\"height: 54px;\">\n<td style=\"width: 30.0991%; height: 54px;\">LV systolic volume/BSA, mL/m2</td>\n<td style=\"width: 9.90052%; height: 54px;\">8–24</td>\n<td style=\"width: 7.2066%; height: 54px;\"><span> 25–32</span></td>\n<td style=\"width: 9.38445%; height: 54px;\"><span> 33–40</span></td>\n<td style=\"width: 9.57649%; height: 54px;\"><span> ≥41</span></td>\n</tr>\n</tbody>\n</table>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
