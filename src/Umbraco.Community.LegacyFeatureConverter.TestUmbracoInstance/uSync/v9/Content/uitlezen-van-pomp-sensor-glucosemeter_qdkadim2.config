    <NodeName Default="Uitlezen van pomp sensor glucosemeter">
      <Name Culture="nl-nl">Uitlezen van pomp sensor glucosemeter</Name>
    </NodeName>
    <SortOrder>7</SortOrder>
    <Published Default="true">
      <Published Culture="nl-nl">true</Published>
    </Published>
    <Schedule />
