    <GenericProperty>
      <Key>956976d1-e2ed-43fd-aa09-f38d42a367a2</Key>
      <Name>Voorbeeld</Name>
      <Alias>preview1902Seo</Alias>
      <Definition>05091895-033d-4439-9e42-cb266405ef16</Definition>
      <Type>preview.1902Seo</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Dit is hoe uw pagina eruit kan zien wanneer deze wordt weergegeven in de zoekresultaten. Houd er rekening mee dat het er in bepaalde gevallen anders uit kan zien, maar over het algemeen is dit wat u kunt verwachten van uw potentiële bezoekers wanneer ze uw pagina in zoekmachines zien.]]></Description>
      <SortOrder>5</SortOrder>
