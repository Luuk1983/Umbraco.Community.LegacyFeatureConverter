    "content": "[\r\n  {\r\n    \"key\": \"169f14e9-a12d-4759-9127-b97a6a0a44be\",\r\n    \"name\": \"Tekst blok\",\r\n    \"ncContentTypeAlias\": \"hoofdContentBlokkenNoTitle\",\r\n    \"PropType\": null,\r\n    \"text\": \"{\\r\\n  \\\"markup\\\": \\\"<p>Alle informatie hoe en wanneer je medicatie krijgt</p>\\\",\\r\\n  \\\"blocks\\\": {\\r\\n    \\\"contentData\\\": [],\\r\\n    \\\"settingsData\\\": []\\r\\n  }\\r\\n}\"\r\n  }\r\n]",
