    "backgroundImageOverlap": "",
    "content": "[\r\n  {\r\n    \"key\": \"64bdd0b1-3361-4b72-becb-004355996024\",\r\n    \"name\": \"Tekst blok\",\r\n    \"ncContentTypeAlias\": \"hoofdContentBlokkenNoTitle\",\r\n    \"PropType\": null,\r\n    \"text\": \"{\\r\\n  \\\"markup\\\": \\\"<p>Dit is een tekstblok zonder titel, in een contentsectie.</p>\\\\n<h3>Kunnen wel andere kopjes in</h3>\\\\n<p>Laten we hier wat gewone tekst zetten</p>\\\\n<h2>Je kan zelfs een rode kop toevoegen</h2>\\\\n<p>Maar deze komt <span style=\\\\\\\"text-decoration: underline;\\\\\\\">niet</span> in de inhoudsopgave (<span class=\\\\\\\"highlighted\\\\\\\">redacteurs dus opgelet!</span>).</p>\\\\n<h3>Plaatje doen?</h3>\\\\n<p><img src=\\\\\\\"?width=476&amp;height=268&amp;mode=max\\\\\\\" alt=\\\\\\\"\\\\\\\" width=\\\\\\\"476\\\\\\\" height=\\\\\\\"268\\\\\\\" data-udi=\\\\\\\"umb://media/7c7da19439e744ccbb66ca7b00c10b9f\\\\\\\"></p>\\\\n<p>Speciaal uit het dierenmapje van Vincent: een stokstaartje</p>\\\\n<h3>We gaan ook een video embedden</h3>\\\\n<div class=\\\\\\\"mceNonEditable embeditem\\\\\\\" data-embed-url=\\\\\\\"https://youtu.be/dRHOxgGHUEI\\\\\\\" data-embed-height=\\\\\\\"96\\\\\\\" data-embed-width=\\\\\\\"200\\\\\\\" data-embed-constrain=\\\\\\\"true\\\\\\\"><iframe width=\\\\\\\"427\\\\\\\" height=\\\\\\\"240\\\\\\\" src=\\\\\\\"https://www.youtube.com/embed/dRHOxgGHUEI?feature=oembed\\\\\\\" frameborder=\\\\\\\"0\\\\\\\" allow=\\\\\\\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\\\\\\\" allowfullscreen=\\\\\\\"\\\\\\\" title=\\\\\\\"Patiënten Servicepunt OLVG\\\\\\\"></iframe></div>\\\\n<p><em>Schijngedrukt,</em> <strong>dikgedrukt,  </strong><span class=\\\\\\\"highlighted\\\\\\\">geel gemarkeerd</span>... het kan allemaal.</p>\\\",\\r\\n  \\\"blocks\\\": {\\r\\n    \\\"contentData\\\": [],\\r\\n    \\\"settingsData\\\": []\\r\\n  }\\r\\n}\"\r\n  },\r\n  {\r\n    \"gradientBlock\": \"[\\r\\n  {\\r\\n    \\\"contentItemContentText\\\": \\\"{\\\\r\\\\n  \\\\\\\"markup\\\\\\\": \\\\\\\"<p>Dit is een verloopblokstao</p>\\\\\\\",\\\\r\\\\n  \\\\\\\"blocks\\\\\\\": {\\\\r\\\\n    \\\\\\\"contentData\\\\\\\": [],\\\\r\\\\n    \\\\\\\"settingsData\\\\\\\": []\\\\r\\\\n  }\\\\r\\\\n}\\\",\\r\\n    \\\"contentItemTitle\\\": \\\"Stap 1\\\",\\r\\n    \\\"key\\\": \\\"d13042b2-de1e-4e40-b4af-481b98d8e5d7\\\",\\r\\n    \\\"name\\\": \\\"Stap 1\\\",\\r\\n    \\\"ncContentTypeAlias\\\": \\\"verloopStep\\\",\\r\\n    \\\"PropType\\\": null\\r\\n  },\\r\\n  {\\r\\n    \\\"contentItemContentText\\\": \\\"{\\\\r\\\\n  \\\\\\\"markup\\\\\\\": \\\\\\\"<p>Lekker stappen...</p>\\\\\\\",\\\\r\\\\n  \\\\\\\"blocks\\\\\\\": {\\\\r\\\\n    \\\\\\\"contentData\\\\\\\": [],\\\\r\\\\n    \\\\\\\"settingsData\\\\\\\": []\\\\r\\\\n  }\\\\r\\\\n}\\\",\\r\\n    \\\"contentItemTitle\\\": \\\"Stap 2\\\",\\r\\n    \\\"key\\\": \\\"bb754110-2737-4c66-ac19-c44024c8074c\\\",\\r\\n    \\\"name\\\": \\\"Stap 2\\\",\\r\\n    \\\"ncContentTypeAlias\\\": \\\"verloopStep\\\",\\r\\n    \\\"PropType\\\": null\\r\\n  },\\r\\n  {\\r\\n    \\\"contentItemContentText\\\": \\\"{\\\\r\\\\n  \\\\\\\"markup\\\\\\\": \\\\\\\"<p>En stap voor stap heb je zo een verloop gemaakt</p>\\\\\\\",\\\\r\\\\n  \\\\\\\"blocks\\\\\\\": {\\\\r\\\\n    \\\\\\\"contentData\\\\\\\": [],\\\\r\\\\n    \\\\\\\"settingsData\\\\\\\": []\\\\r\\\\n  }\\\\r\\\\n}\\\",\\r\\n    \\\"contentItemTitle\\\": \\\"Stap 3\\\",\\r\\n    \\\"key\\\": \\\"00e76f91-b1a6-49fe-a7a6-fc9508819552\\\",\\r\\n    \\\"name\\\": \\\"Stap 3\\\",\\r\\n    \\\"ncContentTypeAlias\\\": \\\"verloopStep\\\",\\r\\n    \\\"PropType\\\": null\\r\\n  }\\r\\n]\",\r\n    \"key\": \"9cbd2502-acbd-4ea2-be9d-60c39304c0b5\",\r\n    \"name\": \"Verloop blok\",\r\n    \"ncContentTypeAlias\": \"nestedContentGradientBlockNoTitle\",\r\n    \"PropType\": null\r\n  },\r\n  {\r\n    \"importantInformationIcon\": \"[\\r\\n  \\\"Ja\\\"\\r\\n]\",\r\n    \"importantInfoText\": \"{\\r\\n  \\\"markup\\\": \\\"<h3>Super belangrijk!</h3>\\\\n<p>Dus knoop het in je oren en niet vergeten!<br />Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Donec quam felis, ultricies nec, pellentesque eu, pretium quis, sem. Nulla consequat massa quis enim. Donec pede justo, fringilla vel, aliquet nec, vulputate eget, arcu. In enim justo, rhoncus ut, imperdiet a, venenatis vitae, justo. Nullam dictum felis eu pede mollis pretium. Integer tincidunt. Cras dapibus. Vivamus elementum semper nisi. Aenean vulputate eleifend tellus. Aenean leo ligula, porttitor eu, consequat vitae, eleifend ac, enim. Aliquam lorem ante, dapibus in, viverra quis, feugiat a, tellus. Phasellus viverra nulla ut metus varius laoreet. Quisque rutrum. Aenean imperdiet. Etiam ultricies nisi vel augue. Curabitur ullamcorper ultricies nisi. Nam eget dui.</p>\\\",\\r\\n  \\\"blocks\\\": {\\r\\n    \\\"contentData\\\": [],\\r\\n    \\\"settingsData\\\": []\\r\\n  }\\r\\n}\",\r\n    \"key\": \"b9d34950-0ad6-45b8-bbb0-e2292c07ed18\",\r\n    \"name\": \"Uitgelicht blok\",\r\n    \"ncContentTypeAlias\": \"belangrijkInformatie\",\r\n    \"PropType\": null\r\n  }\r\n]",
    "key": "f6ef6ab1-f595-4b34-9083-f8b73a4dc16b",
    "name": "Titel van de contentsectie",
    "ncContentTypeAlias": "contentSection",
    "PropType": null,
    "title": "Titel van de contentsectie"
  },
  {
    "backgroundColor": "",
    "backgroundImage": "[]",
    "backgroundImageOverlap": "",
    "content": "[\r\n  {\r\n    \"key\": \"4b59707c-9bcb-4598-ac08-cd196bdf6fb9\",\r\n    \"name\": \"Tekst blok\",\r\n    \"ncContentTypeAlias\": \"hoofdContentBlokkenNoTitle\",\r\n    \"PropType\": null,\r\n    \"text\": \"{\\r\\n  \\\"markup\\\": \\\"<p>En als je nou een blauwe kop boven je element wil plaatsen?<br />Dat kan gewoon, met een beetje hulp van een tekstblok. Kijk maar.</p>\\\\n<h3>Hele goede tips</h3>\\\",\\r\\n  \\\"blocks\\\": {\\r\\n    \\\"contentData\\\": [],\\r\\n    \\\"settingsData\\\": []\\r\\n  }\\r\\n}\"\r\n  },\r\n  {\r\n    \"key\": \"7c4dca98-c03a-40c2-b501-33389902d39f\",\r\n    \"medicalInfoTips\": \"[\\r\\n  {\\r\\n    \\\"key\\\": \\\"402c740f-6220-42b6-9d58-f49f8145e51d\\\",\\r\\n    \\\"name\\\": \\\"Goeie tip\\\",\\r\\n    \\\"ncContentTypeAlias\\\": \\\"tipsItem\\\",\\r\\n    \\\"PropType\\\": null,\\r\\n    \\\"text\\\": \\\"Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa.\\\",\\r\\n    \\\"title\\\": \\\"Goeie tip\\\"\\r\\n  },\\r\\n  {\\r\\n    \\\"key\\\": \\\"719c2a0a-7b42-4f5b-8d68-889dcd6ec857\\\",\\r\\n    \\\"name\\\": \\\"Nog een tip\\\",\\r\\n    \\\"ncContentTypeAlias\\\": \\\"tipsItem\\\",\\r\\n    \\\"PropType\\\": null,\\r\\n    \\\"text\\\": \\\"Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa.\\\",\\r\\n    \\\"title\\\": \\\"Nog een tip\\\"\\r\\n  },\\r\\n  {\\r\\n    \\\"key\\\": \\\"d70350e7-dc89-4419-9032-0e647b53971f\\\",\\r\\n    \\\"name\\\": \\\"Nog ééntje dan\\\",\\r\\n    \\\"ncContentTypeAlias\\\": \\\"tipsItem\\\",\\r\\n    \\\"PropType\\\": null,\\r\\n    \\\"text\\\": \\\"Drie op een rij staat gewoon mooi\\\",\\r\\n    \\\"title\\\": \\\"Nog ééntje dan\\\"\\r\\n  }\\r\\n]\",\r\n    \"name\": \"Tips\",\r\n    \"ncContentTypeAlias\": \"tipsNoTitle\",\r\n    \"PropType\": null\r\n  },\r\n  {\r\n    \"editorialContent\": \"umb://document/4bfdf105635c420c81b1903e04714ae2\",\r\n    \"key\": \"