  <Translations>
    <Translation Language="en-US">Is used as the title on social media when this page is shared. If not set, the meta title will be used.</Translation>
    <Translation Language="nl-NL">Wordt gebruikt als titel op social media als deze pagina gedeeld wordt. Indien niet ingevuld zal de meta titel gebruikt worden.</Translation>
  </Translations>
